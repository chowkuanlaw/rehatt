{
  "name": "rehatt",
  "productName": "Rehatt",
  "version": "0.2.0",
  "description": "Rehatt: a Dynamic Island for Windows. Kopi nudges you when Claude Code or Codex has a question or is done, and it has Lapis Stretch (stretch breaks, water, your kuih) and Teh Tarik Meter (your Claude usage as a glass of teh tarik) inside.",
  "main": "main.js",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "start": "electron .",
    "dist:zip": "electron-builder --win zip",
    "dist:store": "electron-builder --win appx",
    "dist:installer": "electron-builder --win nsis --x64 --publish never"
  },
  "keywords": [],
  "author": "Chow Kuan",
  "homepage": "https://github.com/chowkuanlaw/rehatt",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.chowkuanlaw.rehatt",
    "productName": "Rehatt",
    "copyright": "Copyright (c) 2026 Chow Kuan",
    "files": [
      "**/*",
      "!tests/**",
      "!tools/**",
      "!*.cmd",
      "!dist/**",
      "!smoke/**",
      "!installer/**"
    ],
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "zip",
        "appx"
      ],
      "executableName": "Rehatt"
    },
    "appx": {
      "applicationId": "Rehatt",
      "identityName": "REPLACE_WITH_PARTNER_CENTER_IDENTITY_NAME",
      "publisher": "CN=REPLACE_WITH_PARTNER_CENTER_PUBLISHER_ID",
      "publisherDisplayName": "Chow Kuan",
      "displayName": "Rehatt",
      "backgroundColor": "#0F0F10",
      "languages": [
        "en-US",
        "ms-MY"
      ]
    },
    "asar": false,
    "artifactName": "Rehatt-${version}-win.${ext}",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rehatt",
      "deleteAppDataOnUninstall": false,
      "include": "installer/uninstall.nsh",
      "artifactName": "Rehatt-Setup-${version}.${ext}"
    },
    "directories": {
      "buildResources": "installer"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "chowkuanlaw",
        "repo": "rehatt",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  }
}
